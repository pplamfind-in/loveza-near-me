# Canonical production URL used by SEO metadata, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase public project configuration (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth Web Client ID. This is a public identifier passed to Google Identity Services.
GOOGLE_CLIENT_ID=

# Server-only mapping for the Supabase admin account. Never prefix with NEXT_PUBLIC_.
ADMIN_USERNAME=lovezaadmin
ADMIN_EMAIL=lovezs_admin@gmail.com

# Server-only token and project identifiers used by /admin/analytics.
# VERCEL_PROJECT_ID is available automatically on Vercel; set the analytics override for local dev.
VERCEL_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Search engine ownership verification. Paste the token value only, not the full meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
